table fact_trip
	lineageTag: 4935ab32-8a36-43ad-ba58-d0f0e26be860
	sourceLineageTag: [dbo].[fact_trip]

	measure Trips = COUNTROWS(fact_trip)
		formatString: 0
		lineageTag: 6209fbdd-bdc5-43ba-b6b8-25d67509b2df

		changedProperty = Name

	/// Total charged to passengers, excluding cash tips
	measure Revenue = SUM(fact_trip[total_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f9470206-0a7b-4178-b47d-30c797af48df

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Fare' = AVERAGE(fact_trip[fare_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e83f0973-aca3-4d09-9e78-160e0bbc105e

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Tip %' = DIVIDE(SUM(fact_trip[tip_amount]), SUM(fact_trip[fare_amount]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f6007a2f-57b2-4db4-8e77-fa70f85f6c50

		changedProperty = Name

		changedProperty = FormatString

	measure 'Revenue per Mile' = DIVIDE([Revenue], SUM(fact_trip[trip_distance_mi]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e59cd5f3-0913-4649-9e22-136908ccf73a

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'CBD Fees' = SUM(fact_trip[cbd_congestion_fee])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 4f9675e4-a6ef-4473-9bb5-68cfa3ab077c

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Dropoff Trips' = CALCULATE([Trips], USERELATIONSHIP(fact_trip[dropoff_zone_key], dim_zone[zone_key]))
		formatString: 0
		lineageTag: 140ba294-db62-4bbd-b260-8da658de99db

		changedProperty = Name

	measure 'Revenue MoM %' =
			
			VAR Curr = [Revenue]
			VAR Prev = CALCULATE([Revenue], DATEADD(dim_date[date], -1, MONTH))
			RETURN DIVIDE(Curr - Prev, Prev)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5d03ec74-6b49-4edf-8263-1b3929eab147

		changedProperty = Name

		changedProperty = FormatString

