model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - wh_gold"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit"]

ref table dim_date
ref table dim_payment_type
ref table dim_rate_code
ref table dim_vendor
ref table dim_zone
ref table dq_quarantine_summary
ref table fact_trip
ref table recon_monthly

ref role 'Manhattan Analyst'

